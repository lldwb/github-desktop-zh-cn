{
  "name": "github-desktop-zh-cn",
  "version": "0.1.0",
  "description": "GitHub Desktop 中文汉化补丁工具（字典驱动）：定位安装目录，按 JSON 语言字典替换 resources/app 下 main.js / renderer.js 中的界面文本",
  "license": "GPL-3.0",
  "type": "commonjs",
  "scripts": {
    "locate": "node scripts/locate.js",
    "patch": "node scripts/patch.js",
    "restore": "node scripts/restore.js",
    "verify": "node scripts/verify.js",
    "test": "node --test",
    "scan": "node scripts/scan.js",
    "tool": "node scripts/cli.js",
    "bundle": "node scripts/bundle.js --out tmp/build/bundle.js",
    "build": "node scripts/build.js"
  },
  "engines": {
    "node": ">=18"
  }
}
